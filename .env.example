# URL pública del sitio (ya en uso).
NEXT_PUBLIC_SITE_URL=https://juliantavano.com.ar

# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API.
# Sin estas dos variables el sitio funciona igual (usa los datos estáticos de
# lib/data/*) y el panel muestra el aviso de "falta conectar".
#
# La app NO usa la service-role key: todo pasa por RLS. No la pongas acá.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Resend (formulario de contacto) ────────────────────────────────────────
# resend.com → API Keys. Server-only: NUNCA con prefijo NEXT_PUBLIC_.
# Mientras el remitente sea el de prueba (onboarding@resend.dev), Resend sólo
# entrega al mail con el que se creó la cuenta. Para mandar desde un dominio
# propio y a cualquier casilla hace falta verificar SPF/DKIM.
RESEND_API_KEY=
# Casilla que recibe las consultas del formulario.
CONTACT_TO_EMAIL=

# ── Cloudinary (carga de imágenes del panel) ───────────────────────────────
# cloudinary.com → Dashboard. Cloud name y API key no son secretos (se usan
# en el navegador para la subida firmada); el API secret es server-only y
# firma cada subida en app/actions/cloudinary.ts.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
