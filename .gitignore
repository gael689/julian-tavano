# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude internal
.claude/
skills-lock.json

# utility / dev scripts (not production code)
extract_prototype_images.py
generate_obras.js
contexto-para-claude.md
PROGRESS.md

# source assets not served by the app
image.png

# PDFs (archivos pesados, no van al repo)
*.pdf
# excepto los PDFs servidos por la app (ej. fideicomisos descargables)
!public/inversiones/*.pdf

# Material interno y de trabajo — no va al repo
/CLAUDE.md
/AGENTS.md
/.agents/
/entregable-cliente/
/PENDIENTE.md
/SUPABASE-SETUP.md
